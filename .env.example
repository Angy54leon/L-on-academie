# =====================================================================
# LÉON ACADÉMIE — exemple de configuration
# Copiez ce fichier en « .env » puis remplissez les valeurs SI vous voulez
# activer les fonctions facultatives. Sans .env, l'application fonctionne
# en mode local gratuit (aucun compte, aucune clé).
# ⚠️ Ne publiez JAMAIS votre fichier .env (il est ignoré par Git).
# =====================================================================

# ---------------------------------------------------------------------
# 1) Professeur IA en DÉVELOPPEMENT LOCAL (npm run dev)
#    Ces variables restent côté serveur (pas de préfixe VITE_) :
#    elles ne sont jamais envoyées au navigateur.
#    Tout fournisseur compatible « OpenAI chat completions » fonctionne.
# ---------------------------------------------------------------------
# Exemple Groq (offre gratuite avec quotas, vérifiez les conditions) :
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=nom-du-modele-choisi-dans-la-console
# Exemple Google Gemini (offre gratuite avec quotas ; données pouvant servir à améliorer leurs produits) :
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=nom-du-modele-flash-gratuit
# Exemple Ollama (100 % gratuit et local, sur votre ordinateur, sans clé) :
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2
AI_BASE_URL=
AI_MODEL=
# AI_API_KEY=votre-cle-secrete (exemple fictif, laissez vide pour Ollama)
AI_API_KEY=
# Limites anti-abus du serveur de développement
AI_RATE_PER_MINUTE=8
AI_RATE_PER_DAY=150

# ---------------------------------------------------------------------
# 2) Comptes, synchronisation et espace social (Supabase, facultatif)
#    Ces deux valeurs sont PUBLIQUES par conception (la sécurité repose
#    sur les politiques RLS de la base). Ne mettez JAMAIS ici la clé
#    « service_role ».
# ---------------------------------------------------------------------
# Exemple (valeurs fictives) :
# VITE_SUPABASE_URL=https://votre-projet.supabase.co
# VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# 3) Options avancées (facultatif)
# ---------------------------------------------------------------------
# Adresse du professeur IA si vous l'hébergez ailleurs que sur Supabase :
# VITE_AI_ENDPOINT=https://mon-serveur.exemple/api/teacher
# Adresse publique du site (pour les liens d'invitation) :
# VITE_APP_URL=https://mon-site.exemple
